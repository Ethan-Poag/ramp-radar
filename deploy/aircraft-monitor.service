# Install:  sudo cp aircraft-monitor-server /usr/local/bin/
#           sudo useradd --system --create-home --home-dir /var/lib/aircraft-monitor aircraft-monitor
#           sudo cp deploy/aircraft-monitor.service /etc/systemd/system/
#           sudo systemctl edit aircraft-monitor   # add: [Service]\n Environment=AM_ACCESS_TOKEN=<long random token>
#           sudo systemctl enable --now aircraft-monitor
[Unit]
Description=Aircraft Monitor (headless server)
Wants=network-online.target
After=network-online.target

[Service]
User=aircraft-monitor
Environment=AM_BIND=0.0.0.0:8080
Environment=AM_DATA_DIR=/var/lib/aircraft-monitor
ExecStart=/usr/local/bin/aircraft-monitor-server
Restart=on-failure
RestartSec=5
# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/aircraft-monitor
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
