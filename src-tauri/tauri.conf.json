{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ramp Radar",
  "version": "0.1.0",
  "identifier": "io.github.ethanpoag.rampradar",
  "build": {
    "frontendDist": "../web/dist",
    "beforeBuildCommand": {
      "cwd": "../web",
      "script": "npm ci && npm run build"
    }
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Get alerted when watched aircraft approach an airport",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
