{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ramp Radar",
  "version": "0.1.4",
  "identifier": "io.github.ethanpoag.rampradar",
  "build": {
    "frontendDist": "../web/dist",
    "beforeBuildCommand": {
      "cwd": "../web",
      "script": "npm ci && npm run build"
    }
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Get alerted when watched aircraft approach an airport",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwRjAxNUJENEJFQTgwRDYKUldUV2dPcEx2Ulh3Y0xQQ0R6Vmw3WGE2amFGK3lhTStYY2NXVnpuVHhlZ0FQSUZxUXQ0RThUK3cK",
      "endpoints": [
        "https://github.com/Ethan-Poag/ramp-radar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
